{
  "name": "cinderwake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "npm run format:check && npm run lint && npm run build && npm run art:check && npm run quality:environment:check && npm run art:animation:check && npm run art:selection:check && npm run art:generation:check && npm run art:candidate:check && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "capture:sequence": "node scripts/capture-sequence.mjs",
    "capture:matrix": "node scripts/capture-matrix.mjs",
    "report:screens": "node scripts/build-screen-report.mjs",
    "report:quality": "node scripts/build-quality-index.mjs",
    "art:build": "node scripts/build-sprite-assets.mjs",
    "art:check": "node scripts/validate-sprite-assets.mjs",
    "art:selection:build": "node scripts/build-selection-assets.mjs",
    "art:selection:check": "node scripts/build-selection-assets.mjs --check",
    "art:candidate:check": "node scripts/assess-actor-candidate.mjs --actor ashfang --family primary --profile ashfang-primary-v1 --candidate art/generation/prepared/ashfang-primary-trial-v2.png --output quality-results/actor-candidate-calibration/ashfang-primary-trial-v2",
    "art:presentation:audit": "node scripts/assess-actor-presentation-transform.mjs --experiment art/presentation-experiments/ashfang-uniform-transform-v1.json --output quality-results/actor-presentation/ashfang-uniform-transform-v1",
    "art:animation:audit": "node scripts/audit-actor-atlases.mjs --report-only",
    "art:animation:check": "node scripts/audit-actor-atlases.mjs",
    "quality:environment:check": "node scripts/assess-environment-composition.mjs",
    "art:generation:check": "node scripts/test-generation-pipeline.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "sharp": "^0.34.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
