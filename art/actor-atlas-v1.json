    "southWalk": {
      "atlasRow": 9,
      "runtimeClip": "walk",
      "source": "directions",
      "sourceFrames": [12, 13, 14, 15, 12, 13, 14, 15]
    },
    "northAttack": {
      "atlasRow": 10,
      "runtimeClip": "attack",
      "source": "directionActions",
      "sourceFrames": [0, 1, 2, 2, 3, { "source": "directions", "cell": 0 }]
    },
    "northAbility": {
      "atlasRow": 11,
