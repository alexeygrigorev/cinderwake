{
  "schemaVersion": 2,
  "id": "ActorAtlasV2",
  "description": "The fixed Cinderwake actor rig. Every hero and monster supplies the same identity, direction, action, and reaction source families; the offline builder deterministically normalizes them into fixed, untrimmed atlas cells.",
  "source": {
    "pixelWidth": 1024,
    "pixelHeight": 1024,
    "columns": 4,
    "rows": 4,
    "cellWidth": 256,
    "cellHeight": 256,
    "background": "#ff00ff",
    "files": {
      "primary": "{actor}-source.png",
      "directions": "{actor}-directions-source.png",
      "actions": "{actor}-actions-source.png",
      "reactions": "{actor}-reactions-source.png",
      "directionActions": "{actor}-direction-actions-source.png",
      "directionReactions": "{actor}-direction-reactions-source.png"
    },
    "primaryRows": { "idle": 0, "walk": 1, "attack": 2, "ability": 3 },
    "directionRows": {
      "northIdle": 0,
      "northWalk": 1,
      "southIdle": 2,
      "southWalk": 3
    },
    "reactionRows": {
      "hurt": 0,
      "deathStart": 1,
      "deathEnd": 2,
      "groundedReserve": 3
    },
    "actionLayout": {
      "attackMotionCells": [0, 1, 2, 3, 4],
      "attackReviewReserveCell": 5,
      "recoveryReserveCells": [6, 7],
      "abilityCells": [8, 9, 10, 11, 12, 13, 14, 15],
      "runtimeAttackTerminal": { "source": "primary", "cell": 0 }
    },
    "directionActionRows": {
      "northAttack": 0,
      "northAbility": 1,
      "southAttack": 2,
      "southAbility": 3
    },
    "directionReactionRows": {
      "northHurt": 0,
      "northDeath": 1,
      "southHurt": 2,
      "southDeath": 3
    }
  },
  "atlas": {
    "pixelWidth": 1024,
    "pixelHeight": 2560,
    "columns": 8,
    "rows": 20,
    "cellWidth": 128,
    "cellHeight": 128,
    "footAnchor": { "x": 64, "y": 116 },
    "safeInkBounds": { "x": 5, "y": 4, "width": 118, "height": 112 },
    "reservedRows": [18, 19]
  },
  "clips": {
    "idle": {
      "atlasRow": 0,
      "frameCount": 6,
      "durationTicks": 60,
      "looping": true,
      "source": "primary",
      "sourceFrames": [0, 1, 2, 3, 2, 1]
    },
    "walk": {
      "atlasRow": 1,
      "frameCount": 8,
      "durationTicks": 40,
      "looping": true,
      "source": "primary",
      "sourceFrames": [4, 5, 6, 7, 4, 5, 6, 7]
    },
    "attack": {
      "atlasRow": 2,
      "frameCount": 6,
      "durationTicks": 26,
      "looping": false,
      "source": "actions",
      "sourceFrames": [0, 1, 2, 3, 4, { "source": "primary", "cell": 0 }]
    },
    "ability": {
      "atlasRow": 3,
      "frameCount": 8,
      "durationTicks": 36,
      "looping": false,
      "source": "actions",
      "sourceFrames": [
        8,
        9,
        10,
        11,
        12,
        13,
        14,
        { "source": "primary", "cell": 0 }
      ]
    },
    "hurt": {
      "atlasRow": 4,
      "frameCount": 4,
      "durationTicks": 12,
      "looping": false,
      "source": "reactions",
      "sourceFrames": [0, 1, 2, { "source": "primary", "cell": 0 }],
      "authored": "articulated-recoil"
    },
    "death": {
      "atlasRow": 5,
      "frameCount": 8,
      "durationTicks": 48,
      "looping": false,
      "source": "reactions",
      "sourceFrames": [4, 5, 6, 7, 8, 9, 10, 11],
      "authored": "anatomy-specific-grounded-collapse"
    }
  },
  "directionalClips": {
    "northIdle": {
      "atlasRow": 6,
      "runtimeClip": "idle",
      "source": "directions",
      "sourceFrames": [0, 1, 2, 3, 2, 1]
    },
    "northWalk": {
      "atlasRow": 7,
      "runtimeClip": "walk",
      "source": "directions",
      "sourceFrames": [4, 5, 6, 7, 4, 5, 6, 7]
    },
    "southIdle": {
      "atlasRow": 8,
      "runtimeClip": "idle",
      "source": "directions",
      "sourceFrames": [8, 9, 10, 11, 10, 9]
