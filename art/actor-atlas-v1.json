      "sourceFrames": [0, 1, 2, { "source": "directions", "cell": 0 }]
    },
    "northDeath": {
      "atlasRow": 13,
      "runtimeClip": "death",
      "source": "directionReactions",
      "sourceFrames": [4, 4, 5, 5, 6, 6, 7, 7]
    },
    "southAttack": {
      "atlasRow": 14,
      "runtimeClip": "attack",
      "source": "directionActions",
      "sourceFrames": [8, 9, 10, 10, 11, { "source": "directions", "cell": 8 }]
    },
    "southAbility": {
      "atlasRow": 15,
      "runtimeClip": "ability",
      "source": "directionActions",
      "sourceFrames": [
        12,
        13,
        14,
        14,
        15,
        15,
        15,
        { "source": "directions", "cell": 8 }
      ]
    },
    "southHurt": {
      "atlasRow": 16,
      "runtimeClip": "hurt",
      "source": "directionReactions",
      "sourceFrames": [8, 9, 10, { "source": "directions", "cell": 8 }]
    },
    "southDeath": {
      "atlasRow": 17,
      "runtimeClip": "death",
      "source": "directionReactions",
      "sourceFrames": [12, 12, 13, 13, 14, 14, 15, 15]
    }
  },
  "actorOverrides": {
    "arcanist": {
      "clips": {
        "walk": {
          "frameTransform": {
            "scaleX": 1,
            "scaleY": 1.23,
            "anchor": "foot"
          },
          "reason": "Normalize the undersized side-on walk bank to the idle body-height envelope while preserving the authored stride and fixed foot contact."
        }
      },
      "transitionContracts": {
        "eastWestIdleWalk": {
          "clips": ["idle", "walk"],
          "facings": ["east", "west"],
          "anchor": "foot",
          "maximumAtlasMedianInkHeightDifference": 8,
          "reason": "The character must not visibly shrink when side-on input starts; this atlas-level contract is stricter than the 8 logical-pixel rendered-sequence limit."
        }
      }
    },
    "ashfang": {
      "clips": {
        "walk": {
          "frameTransform": {
            "scaleX": 0.9,
            "scaleY": 1.17,
            "anchor": "foot"
          },
          "reason": "Keep the low side-on run within the idle body-height envelope without the former vertical stretch, while preserving cadence, source identity, and fixed foot contact."
        },
        "ability": {
          "sourceFrames": [
            8,
            9,
            9,
            11,
            12,
            13,
            14,
            { "source": "primary", "cell": 0 }
          ],
          "reason": "Hold the charged crouch for one frame and omit the disconnected airborne pose before the ground strike."
        }
      },
      "transitionContracts": {
        "eastWestIdleWalk": {
          "clips": ["idle", "walk"],
          "facings": ["east", "west"],
          "anchor": "foot",
          "maximumAtlasMedianInkHeightDifference": 8,
          "reason": "The quadruped must not visibly grow when locomotion begins; this atlas-level contract is stricter than the 8 logical-pixel rendered-sequence limit."
        }
      }
    }
  },
  "facing": {
    "east": "primary-bank",
    "west": "primary-bank-horizontal-flip",
    "north": "authored-north-bank",
    "south": "authored-south-bank",
    "actionFallback": "none-all-cardinal-banks-authored"
  }
}
