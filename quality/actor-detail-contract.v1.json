{
  "schemaVersion": 1,
  "contract": "CinderwakeActorRuntimeDetailV1",
  "algorithmVersion": "cinderwake-actor-runtime-detail-v1",
  "scope": {
    "included": "One finished-surface actor frame at its exact 128x128 runtime projection.",
    "excluded": [
      "anatomy and silhouette quality",
      "pose, contact, topology, and animation continuity",
      "unfinished flat-color anatomy blockouts whose intentionally sparse surfaces are not production art"
    ],
    "limitation": "This provisional raster detector is a triage gate, not a visual approval system. Exact-hash independent visual review remains mandatory for art acceptance and production promotion."
  },
  "algorithm": {
    "alphaInterior": {
      "visibleAlphaMinimum": 192,
      "erosion": "A pixel is usable only when every alpha value in its centered 5x5 square is at least 192 (two-pixel square erosion)."
    },
    "luma": "Rec.709 luma: 0.2126 R + 0.7152 G + 0.0722 B, evaluated without quantizing the result.",
    "blur": "Separable 3x3 binomial blur with kernel [1,2,1]/4 horizontally and then vertically.",
    "highPass": "Absolute difference between the unblurred luma and binomial-blurred luma.",
    "classes": {
      "flat": "h < 2",
      "weak": "2 <= h < 8",
      "strong": "h >= 8"
    },
    "occupancyDenominator": "All usable interior pixels.",
    "readability": "strong pixels / (weak pixels + strong pixels), or zero when there are no detailed pixels.",
    "isolatedExtrema": "A usable pixel whose luma is at least 8 above every one of its eight neighbors or at least 8 below every one of its eight neighbors.",
    "rounding": "Reported ratios are rounded to six decimal places; integer counts are authoritative."
  },
  "thresholds": {
    "status": "provisional-frozen",
    "usableInteriorMinimum": 500,
    "strongOccupancyMinimum": 0.3,
    "strongOccupancyMaximum": 0.6,
    "readabilityMinimum": 0.38,
    "isolatedExtremaOccupancyMaximum": 0.07
  },
  "calibrationFixtures": [
